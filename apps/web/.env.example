# Optional: origin reachable from your phone for desktop QR handoff.
# Without this setting, QR codes use the current page origin.
NEXT_PUBLIC_APP_URL=
# Contact address shown in the privacy policy.
NEXT_PUBLIC_PRIVACY_EMAIL=

# Supabase Auth. Use the project's publishable key, never a secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Enable only after Apple is configured in Supabase Auth.
NEXT_PUBLIC_ENABLE_APPLE_AUTH=false

# Universal / app links for printed venue QR codes (/v/<code>). Leave empty until the apps are signed;
# the .well-known files return 404 while unset.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
