# Public client configuration only. Never use a Supabase secret or service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exact web origin, without a trailing slash, for unwrapping first-party QR links.
EXPO_PUBLIC_WEB_ORIGIN=

# Enable Google after its native callback is configured.
# Google OAuth verification is deferred from the release-candidate checks.
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=false
